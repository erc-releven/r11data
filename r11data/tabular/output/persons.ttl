    rdfs:label "p. 268" ;
    ns1:P190_has_symbolic_content "Testes, qui cum eo fuerunt: dux Lambertus frater eius, dux Dauid consobrinus eius, Gerazclauus filius regis Rutenorum gener ipsius, Almarus Uespremensis episcopus, comes palatinus Petrus et comes Acha, Michael, Seraphin, Copan capellani illius, Rotbertus de Gozlaria spatarius eius, Anulsus legatus ipsius." ;
