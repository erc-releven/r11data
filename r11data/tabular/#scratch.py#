def apply_model(model_type: type[BaseModel], df: pd.DataFrame):
    cnt = 0
    for n, row in df.iterrows():
        try:
            model_type(**row.to_dict())
            cnt += 1
        except ValidationError as e:
            print("Error: ", n)
            raise e

    return cnt


