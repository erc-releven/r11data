@prefix : <https://r11.eu/ns/similarity/> .
@prefix so: <https://r11.eu/ns/similarity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <https://r11.eu/ns/similarity/> .

<https://r11.eu/ns/similarity> rdf:type owl:Ontology ;
                                           rdfs:comment "This ontology is implemented according to the specifications given in Harry Halpin et al., ‘When Owl:sameAs Isn’t the Same: An Analysis of Identity in Linked Data’, in The Semantic Web – ISWC 2010 (International Semantic Web Conference, Springer, Berlin, Heidelberg, 2010), 305–20, https://doi.org/10.1007/978-3-642-17746-0_20."@en .

#################################################################
#    Object Properties
#################################################################

###  https://r11.eu/ns/similarity/ID1_claimsSimilar
so:ID1_claimsSimilar rdf:type owl:ObjectProperty ,
                              owl:ReflexiveProperty .


###  https://r11.eu/ns/similarity/ID2_claimsRelated
so:ID2_claimsRelated rdf:type owl:ObjectProperty .


###  https://r11.eu/ns/similarity/ID3_similar
so:ID3_similar rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf so:ID1_claimsSimilar ;
               rdf:type owl:SymmetricProperty ,
                        owl:ReflexiveProperty .


###  https://r11.eu/ns/similarity/ID4_claimsMatches
so:ID4_claimsMatches rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf so:ID1_claimsSimilar ,
                                        so:ID2_claimsRelated ;
                     rdf:type owl:TransitiveProperty .


###  https://r11.eu/ns/similarity/ID5_related
so:ID5_related rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf so:ID2_claimsRelated ;
               rdf:type owl:SymmetricProperty .


###  https://r11.eu/ns/similarity/ID6_claimsIdentical
so:ID6_claimsIdentical rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf so:ID4_claimsMatches ;
                       rdf:type owl:TransitiveProperty ,
                                owl:ReflexiveProperty .


###  https://r11.eu/ns/similarity/ID7_matches
so:ID7_matches rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf so:ID3_similar ,
                                  so:ID4_claimsMatches ,
                                  so:ID5_related ;
               rdf:type owl:SymmetricProperty ,
                        owl:TransitiveProperty .


###  https://r11.eu/ns/similarity/ID8_identical
so:ID8_identical rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf so:ID6_claimsIdentical ,
                                    so:ID7_matches ;
                 rdf:type owl:SymmetricProperty ,
                          owl:TransitiveProperty ,
                          owl:ReflexiveProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdfs:subPropertyOf so:ID2_claimsRelated .


###  http://www.w3.org/2002/07/owl#sameAs
owl:sameAs rdfs:subPropertyOf so:ID8_identical .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdfs:subPropertyOf so:ID3_similar .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdfs:subPropertyOf so:ID7_matches .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdfs:subPropertyOf so:ID5_related .


