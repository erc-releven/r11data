@prefix aaao: <https://ontology.swissartresearch.net/aaao/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pwro: <https://ontology.swissartresearch.net/pwro/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdhss: <https://r11.eu/ns/prosopography/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix so: <https://r11.eu/ns/similarity/> .
@prefix spec: <https://r11.eu/ns/spec/> .
@prefix star: <https://r11.eu/ns/star/> .

rdfs:Class a rdfs:Class ;
    rdfs:label "Class" ;
    rdfs:comment "The class of classes." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdfs:Resource .

rdfs:Container a rdfs:Class ;
    rdfs:label "Container" ;
    rdfs:comment "The class of RDF containers." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdfs:Resource .

rdfs:ContainerMembershipProperty a rdfs:Class ;
    rdfs:label "ContainerMembershipProperty" ;
    rdfs:comment "The class of container membership properties, rdf:_1, rdf:_2, ..., all of which are sub-properties of 'member'." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdf:Property .

rdfs:Datatype a rdfs:Class ;
    rdfs:label "Datatype" ;
    rdfs:comment "The class of RDF datatypes." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdfs:Class .

rdfs:Literal a rdfs:Class ;
    rdfs:label "Literal" ;
    rdfs:comment "The class of literal values, eg. textual strings and integers." ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:subClassOf rdfs:Resource .

rdfs:Resource a rdfs:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "The class resource, everything." ;
    rdfs:isDefinedBy rdfs: .

lrmoo:F11_Corporate_Body a owl:Class ;
    rdfs:label "Corporate Body"@en ;
    rdfs:comment "This class comprises organisations and groups of two or more people and/or organisations acting as a unit. To be considered an instance of F11 Corporate Body a gathering of people needs to bear a name and exhibit organisational characteristics sufficient to allow the body as a whole to participate in the creation, modification or production of an E73 Information Object. Groups such as conferences, congresses, expeditions, exhibitions, festivals, fairs, etc. are modelled as F11 Corporate Bodies when they are named and can take collective action, such as approving a report or publishing their proceedings."@en ;
    rdfs:subClassOf lrmoo:F55_Collective_Agent .

lrmoo:F39_Family a owl:Class ;
    rdfs:label "Family"@en ;
    rdfs:comment "This class comprises groups of two or more persons presented as a family and justified by relationships of birth, marriage, adoption, civil union, or similar social or legal status and an assumed common tradition, including examples such as royal families, dynasties, houses of nobility, etc."@en ;
    rdfs:subClassOf lrmoo:F55_Collective_Agent .

lrmoo:R33_has_string a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "has string"@en ;
    rdfs:comment "This property associates an instance of F12 Nomen with a sign or arrangement of signs that is used to refer to something through that instance of F12 Nomen."@en ;
    rdfs:domain lrmoo:F12_Nomen ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P3_has_note .

<http://www.cidoc-crm.org/cidoc-crm> a owl:Ontology ;
    rdfs:comment "This ontology is the result of importing the class and property definitions of the RDF file given at https://cidoc-crm.org/rdfs/7.1.2/CIDOC_CRM_v7.1.2.rdfs ."@en ;
    owl:versionIRI crm:7.1.2 .

crm: owl:versionInfo "RDFs Implementation (September 2022) of CIDOC-CRM 7.1.2"@en .

crm:E25_Human-Made_Feature a owl:Class ;
    rdfs:label "Human-Made Feature"@en ;
    rdfs:comment "This class comprises physical features that are purposely created by human activity, such as scratches, artificial caves, artificial water channels, etc. In particular, it includes the information encoding features on mechanical or digital carriers."@en ;
    rdfs:subClassOf crm:E24_Physical_Human-Made_Thing,
        crm:E26_Physical_Feature .

crm:E27_Site a owl:Class ;
    rdfs:label "Gelände"@de,
        "Φυσικός Χώρος"@el,
        "Site"@en,
        "Site"@fr,
        "Lugar"@pt,
        "Участок"@ru,
        "场地"@zh ;
    rdfs:comment """This class comprises pieces of land or sea floor.
In contrast to the purely geometric notion of E53 Place, this class describes constellations of matter on the surface of the Earth or other celestial body, which can be represented by photographs, paintings and maps.
Instances of E27 Site are composed of relatively immobile material items and features in a particular configuration at a particular location."""@en ;
    rdfs:subClassOf crm:E26_Physical_Feature .

crm:E33_E41_Linguistic_Appellation a owl:Class ;
    rdfs:label "Linguistic Appellation" ;
    rdfs:comment "This class has been created for Appellations being regarded specific to or characteristic for a language group and being described indirectly via a URI." ;
    rdfs:subClassOf crm:E33_Linguistic_Object,
        crm:E41_Appellation .

crm:E34_Inscription a owl:Class ;
    rdfs:label "Inschrift"@de,
        "Επιγραφή"@el,
        "Inscription"@en,
        "Inscription"@fr,
        "Inscrição"@pt,
        "Надпись"@ru,
        "题识"@zh ;
    rdfs:comment """This class comprises recognisable, texts attached to instances of E24 Physical Human-Made Thing.
The transcription of the text can be documented in a note by P3 has note: E62 String. The alphabet used can be documented by P2 has type: E55 Type. This class does not intend to describe the idiosyncratic characteristics of an individual physical embodiment of an inscription, but the underlying prototype. The physical embodiment is modelled in the CIDOC CRM as instances of E24 Physical Human-Made Thing.
The relationship of a physical copy of a book to the text it contains is modelled using E18 Physical Thing. P128 carries (is carried by): E33 Linguistic Object."""@en ;
    rdfs:subClassOf crm:E33_Linguistic_Object,
        crm:E37_Mark .

crm:P168_place_is_defined_by a owl:DatatypeProperty ;
    rdfs:label "place is defined by"@en ;
    rdfs:comment "This property associates an instance of E53 Place with an instance of E94 Space Primitive that defines it. Syntactic variants or use of different scripts may result in multiple instances of E94 Space Primitive defining exactly the same place. Transformations between different reference systems always result in new definitions of places approximating each other and not in alternative definitions."@en ;
    rdfs:domain crm:E53_Place ;
    rdfs:range rdfs:Literal .

crm:P169i_spacetime_volume_is_defined_by a owl:DatatypeProperty ;
    rdfs:label "spacetime volume is defined by"@en ;
    rdfs:comment "Scope note for 'P169': This property associates an instance of E95 Spacetime Primitive with the instance of E92 Spacetime Volume it defines."@en ;
    rdfs:domain crm:E92_Spacetime_Volume ;
    rdfs:range rdfs:Literal .

crm:P170i_time_is_defined_by a owl:DatatypeProperty ;
    rdfs:label "time is defined by"@en ;
    rdfs:comment """Scope note for 'P170': This property associates an instance of E61 Time Primitive with the instance of E52 Time-Span that constitutes the interpretation of the terms of the time primitive as an extent in absolute, real time.
The quantification allows several instances of E61 Time Primitive that are each expressed in different syntactic forms, to define the same instance of E52 Time-Span."""@en ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal .

crm:P171_at_some_place_within a owl:DatatypeProperty ;
    rdfs:label "at some place within"@en ;
    rdfs:comment """This property describes the maximum spatial extent within which an instance of E53 Place falls. Since instances of E53 Places may not have precisely known spatial extents, the CIDOC CRM supports statements about maximum spatial extents of instances of E53 Place. This property allows an instance of E53 Place’s maximum spatial extent (i.e., its outer boundary) to be assigned an instance of E94 Space Primitive value.
This property is a shortcut of the fully developed path from E53 Place, P89 falls within, E53 Place, P168 place is defined by to E94 Space Primitive through a declarative Place that is not explicitly documented, to a Space Primitive: declarative places are defined in CRMgeo (Doerr and Hiebel 2013)."""@en ;
    rdfs:domain crm:E53_Place ;
    rdfs:range rdfs:Literal .

crm:P172_contains a owl:DatatypeProperty ;
    rdfs:label "contains"@en ;
    rdfs:comment """This property describes a minimum spatial extent which is contained within an instance of E53 Place. Since instances of E53 Place may not have precisely known spatial extents, the CIDOC CRM supports statements about minimum spatial extents of instances of E53 Place. This property allows an instance of E53 Places’s minimum spatial extent (i.e., its inner boundary or a point being within a Place) to be assigned an instance of E94 Space Primitive value.
This property is a shortcut of the fully developed path from E53 Place, P89i contains, E53 Place, P168 place is defined by to E94 Space Primitive"""@en ;
    rdfs:domain crm:E53_Place ;
    rdfs:range rdfs:Literal .

crm:P190_has_symbolic_content a owl:DatatypeProperty ;
    rdfs:label "has symbolic content"@en ;
    rdfs:comment """This property associates an instance of E90 Symbolic Object with a complete, identifying representation of its content in the form of an instance of E62 String.
This property only applies to instances of E90 Symbolic Object that can be represented completely in this form. The representation may be more specific than the symbolic level defining the identity condition of the represented. This depends on the type of the symbolic object represented. For instance, if a name has type "Modern Greek character sequence", it may be represented in a loss-free Latin transcription, meaning however the sequence of Greek letters.
As another example, if the represented object has type "English words sequence", American English or British English spelling variants may be chosen to represent the English word "colour" without defining a different symbolic object. If a name has type "European traditional name", no particular string may define its content."""@en ;
    rdfs:domain crm:E90_Symbolic_Object ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P3_has_note .

crm:P57_has_number_of_parts a owl:DatatypeProperty ;
    rdfs:label "hat Anzahl Teile"@de,
        "έχει αριθμό μερών"@el,
        "has number of parts"@en,
        "a pour nombre de parties"@fr,
        "tem número de partes"@pt,
        "имеет число частей"@ru,
        "有组成部分数"@zh ;
    rdfs:comment """This property documents the number of parts, an instance of E60 Number, of which an instance of E19 Physical Object is composed.
This may be used as a method of checking inventory counts with regard to aggregate or collective objects. What constitutes a part or component depends on the context and requirements of the documentation. Normally, the parts documented in this way would not be considered as worthy of individual attention.
For a more complete description, objects may be decomposed into their components and constituents using P46 is composed of (forms parts of) and P45 consists of (is incorporated in). This allows each element to be described individually."""@en ;
    rdfs:domain crm:E19_Physical_Object ;
    rdfs:range rdfs:Literal .

crm:P79_beginning_is_qualified_by a owl:DatatypeProperty ;
    rdfs:label "hat Anfangsbegründung"@de,
        "αρχή προσδιορίζεται από"@el,
        "beginning is qualified by"@en,
        "début est qualifié par"@fr,
        "início é qualificado por"@pt,
        "начало ограничено"@ru,
        "起始限定"@zh ;
    rdfs:comment "This property associates an instance of E52 Time-Span with a note detailing the scholarly or scientific opinions and justifications about the certainty, precision, sources etc. of its beginning. Such notes may also be used to elaborate arguments about constraints or to give explanations of alternatives."@en ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P3_has_note .

crm:P80_end_is_qualified_by a owl:DatatypeProperty ;
    rdfs:label "hat Begründung des Endes"@de,
        "τέλος προσδιορίζεται από"@el,
        "end is qualified by"@en,
        "fin est qualifiée par"@fr,
        "final é qualificado por"@pt,
        "конец ограничен"@ru,
        "结束限定"@zh ;
    rdfs:comment "This property associates an instance of E52 Time-Span with a note detailing the scholarly or scientific opinions and justifications about the end of this time-span concerning certainty, precision, sources etc. This property may also be used to describe arguments constraining possible dates and to distinguish reasons for alternative dates."@en ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P3_has_note .

crm:P81a_end_of_the_begin a owl:DatatypeProperty ;
    rdfs:label "Ende des Anfangs"@de,
        "τέλος της αρχής"@el,
        "end of the begin"@en,
        "fin du début"@fr,
        "fim do início"@pt,
        "конец начала"@ru ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P81_ongoing_throughout .

crm:P81b_begin_of_the_end a owl:DatatypeProperty ;
    rdfs:label "Anfang vom Ende"@de,
        "αρχή του τέλους"@el,
        "begin of the end"@en,
        "début de la fin"@fr,
        "começar do fim"@pt,
        "начать в конце"@ru ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P81_ongoing_throughout .

crm:P82a_begin_of_the_begin a owl:DatatypeProperty ;
    rdfs:label "Anfang des Anfangs"@de,
        "αρχή της αρχής"@el,
        "begin of the begin"@en,
        "début du début"@fr,
        "começar do início"@pt,
        "начать с начала"@ru ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P82_at_some_time_within .

crm:P82b_end_of_the_end a owl:DatatypeProperty ;
    rdfs:label "Ende vom Ende"@de,
        "τέλος του τέλους"@el,
        "end of the end"@en,
        "fin de la fin"@fr,
        "fim do fim"@pt,
        "конец конец"@ru ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P82_at_some_time_within .

crm:P90a_has_lower_value_limit a owl:DatatypeProperty ;
    rdfs:label "has lower value limit"@en ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P90_has_value .

crm:P90b_has_upper_value_limit a owl:DatatypeProperty ;
    rdfs:label "has upper value limit"@en ;
    rdfs:domain crm:E54_Dimension ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf crm:P90_has_value .

crmdig: a owl:Ontology ;
    rdfs:comment "This ontology is the result of importing the class and property definitions of the RDF file downloaded from https://ontome.net/namespace/211#identification."@en ;
    owl:imports crm:7.1.2 ;
    owl:versionIRI crmdig:4.0 .

rdfs:comment a rdf:Property ;
    rdfs:label "comment" ;
    rdfs:comment "A description of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Literal .

rdfs:domain a rdf:Property ;
    rdfs:label "domain" ;
    rdfs:comment "A domain of the subject property." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Class .

rdfs:isDefinedBy a rdf:Property ;
    rdfs:label "isDefinedBy" ;
    rdfs:comment "The definition of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Resource ;
    rdfs:subPropertyOf rdfs:seeAlso .

rdfs:label a rdf:Property ;
    rdfs:label "label" ;
    rdfs:comment "A human-readable name for the subject." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Literal .

rdfs:member a rdf:Property ;
    rdfs:label "member" ;
    rdfs:comment "A member of the subject resource." ;
    rdfs:domain rdfs:Resource ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Resource .

rdfs:range a rdf:Property ;
    rdfs:label "range" ;
    rdfs:comment "A range of the subject property." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Class .

rdfs:subClassOf a rdf:Property ;
    rdfs:label "subClassOf" ;
    rdfs:comment "The subject is a subclass of a class." ;
    rdfs:domain rdfs:Class ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdfs:Class .

rdfs:subPropertyOf a rdf:Property ;
    rdfs:label "subPropertyOf" ;
    rdfs:comment "The subject is a subproperty of a property." ;
    rdfs:domain rdf:Property ;
    rdfs:isDefinedBy rdfs: ;
    rdfs:range rdf:Property .

owl:sameAs rdfs:subPropertyOf so:ID8_identical .

skos:closeMatch rdfs:subPropertyOf so:ID3_similar .

skos:exactMatch rdfs:subPropertyOf so:ID7_matches .

skos:related rdfs:subPropertyOf so:ID5_related .

aaao: a owl:Ontology ;
    rdfs:comment "This ontology is still in development. Only relevant classes for releven have been placed in this document. Full documentation can be found at https://ontome.net/namespace/120."@en ;
    owl:imports aaao:1.5.4 ;
    owl:versionIRI aaao:1.5.4 .

aaao:ZE13_Speech_Act a owl:Class ;
    rdfs:label "Speech Act"@en ;
    rdfs:comment "An instance of speech act  comprises an intentional activity engaged in by a set of actors to create a new institutional fact - or to nullify an existing one - that holds for a given community. In this sense, a speech act is transformative symbolic act. Speech acts are carried out by intentional actors through invoking a social rule and performing a prescribed set of actions often including the locution of set formulae of phrases by certain actors, fulfilling certain roles. Correct execution of the speech act as specified by the rule results in the existence of new institutional facts or their negation. The substance of speech act is ritual action performed by a group. An instance of speech act begins when the intended ritual proceeding as specified by the rule invoked is initiated. The instance of speech act ends when the required set of actions specified for the act in question are executed or it is abandoned." ;
    rdfs:subClassOf aaao:ZE52_Transformative_Symbolic_Act .

pwro: a owl:Ontology ;
    rdfs:comment "This ontology is still in development. Only relevant classes for releven have been placed in this document. Full documentation can be found at https://ontome.net/namespace/280."@en ;
    owl:imports pwro:1.0.0 ;
    owl:versionIRI pwro:1.0.0 .

pwro:WE8_Intentional_Destruction a owl:Class ;
    rdfs:label "Intentional Destruction"@en ;
    rdfs:comment "This class comprises events which are deliberately undertaken to cause the destruction of some physical thing and which succeed in that effort. The substance of this class is intentional activity with intent to destroy. Instances of this class come into existence when an actor begins an action that is intended to and capable of bringing about the end of existence of a physical object through a deliatory action. Instances of this class cease to be when the aim of destroying the object is achieved and the object is destroyed." ;
    rdfs:subClassOf crm:E6_Destruction,
        pwro:WE9_Destructive_Physical_Modification .

<https://r11.eu/ns/prosopography> a owl:Ontology ;
    rdfs:comment "This ontology contains the classes and properties borrowed from the SDHSS project (https://ontome.net/project/8) and used in our project for person information. Since the SDHSS ontologies aren't formally published, we have linked the entities we use more directly to the CIDOC-CRM superclasses than the original ontology suggests; this is to protect our use against any reorganisation of the intermediate classes that may occur in the meantime."@en ;
    owl:versionIRI sdhss:0.1 .

sdhss:C101 a owl:Class ;
    rdfs:label "Association with Location" ;
    rdfs:subClassOf crm:E92_Spacetime_Volume .

sdhss:C11 a owl:Class ;
    rdfs:label "Gender"@en ;
    rdfs:comment "Gender is the state of being male, female, or an analogous category (non-binary, eunuch, etc.) in relation to the social and cultural roles that are considered appropriate for the respective categories. (Adapted from Collins)"@en ;
    rdfs:isDefinedBy "https://ontome.net/class/629/namespace/112"@en ;
    rdfs:subClassOf sdhss:C2 .

sdhss:C14 a owl:Class ;
    rdfs:label "Holding of a Right or Obligation"@en ;
    rdfs:isDefinedBy "https://ontome.net/class/688/namespace/112"@en ;
    rdfs:subClassOf crm:E2_Temporal_Entity .

sdhss:C5 a owl:Class ;
    rdfs:label "Membership" ;
    rdfs:comment "This class models the fact that a person or an organization belongs to a group during a given time span" ;
    rdfs:isDefinedBy "https://ontome.net/class/442/namespace/112" ;
    rdfs:subClassOf crm:E2_Temporal_Entity .

sdhss:C7 a owl:Class ;
    rdfs:label "Occupation"@en ;
    rdfs:comment "A job, profession or other activity"@en ;
    rdfs:isDefinedBy "https://ontome.net/class/636/namespace/112"@en ;
    rdfs:subClassOf sdhss:C2 .

<https://r11.eu/ns/similarity> a owl:Ontology ;
    rdfs:comment "This ontology is implemented according to the specifications given in Harry Halpin et al., ‘When Owl:sameAs Isn’t the Same: An Analysis of Identity in Linked Data’, in The Semantic Web – ISWC 2010 (International Semantic Web Conference, Springer, Berlin, Heidelberg, 2010), 305–20, https://doi.org/10.1007/978-3-642-17746-0_20."@en .

<https://r11.eu/ns/spec> a owl:Ontology ;
    rdfs:comment "This ontology contains the subclasses of and shortcuts for CIDOC-CRM elements that are necessary for distinguishing different sorts of RELEVEN data that belong to the same CRM superclass."@en ;
    owl:imports lrmoo:,
        crm:7.1.2 .

spec:Author_Group a owl:Class ;
    rdfs:subClassOf crm:E74_Group .

spec:Authority_Status_Type a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

spec:Bibliography a owl:Class ;
    rdfs:subClassOf crm:E73_Information_Object .

spec:Boulloterion a owl:Class ;
    rdfs:subClassOf crm:E22_Human-Made_Object .

spec:Boulloterion_Type a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

spec:Correspondence a owl:Class ;
    rdfs:subClassOf crm:E22_Human-Made_Object .

spec:Ethnic_Group a owl:Class ;
    rdfs:subClassOf crm:E74_Group .

spec:Gender_Assignment a owl:Class ;
    rdfs:subClassOf crm:E17_Type_Assignment .

spec:Geopolitical_Event a owl:Class ;
    rdfs:subClassOf crm:E7_Activity .

spec:Geopolitical_Event_Type a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

spec:Lead_Seal a owl:Class ;
    rdfs:subClassOf crm:E22_Human-Made_Object .

spec:Manuscript a owl:Class ;
    rdfs:subClassOf crm:E22_Human-Made_Object .

spec:Manuscript_Type a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

spec:Passage a owl:Class ;
    rdfs:subClassOf crm:E33_Linguistic_Object .

spec:Place_Type a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

spec:Publication a owl:Class ;
    rdfs:subClassOf lrmoo:F2_Expression .

spec:Relationship_Category a owl:Class ;
    rdfs:subClassOf crm:E55_Type .

spec:Text_Expression a owl:Class ;
    rdfs:subClassOf lrmoo:F2_Expression .

star: a owl:Ontology ;
    owl:imports crm:7.1.2 ;
    owl:versionIRI star:0.1 .

star:E13_aaao_ZP100 a owl:Class ;
    rdfs:subClassOf crm:E13_Attribute_Assignment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( crm:E13_Attribute_Assignment [ a owl:Restriction ;
                        owl:hasValue aaao:ZP100_challenged ;
                        owl:onProperty crm:P177_assigned_property_of_type ] ) ] .

star:E13_aaao_ZP114 a owl:Class ;
    rdfs:subClassOf crm:E13_Attribute_Assignment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( crm:E13_Attribute_Assignment [ a owl:Restriction ;
                        owl:hasValue aaao:ZP114_has_geographic_scope ;
                        owl:onProperty crm:P177_assigned_property_of_type ] ) ] .

star:E13_aaao_ZP42 a owl:Class ;
    rdfs:subClassOf crm:E13_Attribute_Assignment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( crm:E13_Attribute_Assignment [ a owl:Restriction ;
                        owl:hasValue aaao:ZP42_intentionally_initiated ;
                        owl:onProperty crm:P177_assigned_property_of_type ] ) ] .

star:E13_aaao_ZP75 a owl:Class ;
